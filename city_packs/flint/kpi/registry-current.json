  "kpi_definitions": [
    {
      "city_pack": "flint",
      "kpi_id": "population_capacity",
      "scope": "city",
      "display_name": "Population capacity",
      "unit": "people",
      "formula": "total_units * multiplier('residential_people_per_unit')",
      "source_note": "Estimated units from buildable envelopes multiplied by ACS household-size assumption.",
      "required_multipliers": ["residential_people_per_unit"],
      "precision": 0
    },
    {
      "city_pack": "flint",
      "kpi_id": "buildable_floor_area",
      "scope": "city",
      "display_name": "Buildable floor area",
      "unit": "m2",
      "formula": "total_buildable_floor_area_m2",
      "source_note": "Summed from scenario-aware buildable envelope rows.",
      "required_multipliers": [],
      "precision": 0
    },
    {
      "city_pack": "flint",
      "kpi_id": "tax_base_capacity",
      "scope": "city",
      "display_name": "Tax base capacity",
      "unit": "usd/year",
      "formula": "total_buildable_floor_area_m2 * multiplier('taxable_value_per_buildable_m2')",
      "source_note": "Planning-scale floor area multiplied by a cited local comparable value assumption.",
      "required_multipliers": ["taxable_value_per_buildable_m2"],
      "precision": 0
